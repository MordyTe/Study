# Copy to .env and fill in. NEVER commit .env

# Telegram (required for delivery)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Gemini (optional — agent works without it, signals ship without LLM opinion)
GEMINI_API_KEY=

# Bybit read-only API keys (OPTIONAL — public market data needs no keys at all)
BYBIT_API_KEY=
BYBIT_API_SECRET=
