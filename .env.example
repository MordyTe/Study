# ─────────────────────────────────────────────────────────────
# Bybit Pattern Scanner — environment template
# Copy to .env.local for local dev, or set in Vercel > Settings > Environment Variables.
#
# EVERY VARIABLE HERE IS OPTIONAL.
# The app runs with live Bybit public market data using ZERO configuration.
# ─────────────────────────────────────────────────────────────

# ── NO BYBIT KEYS. EVER. ─────────────────────────────────────
# This application is analysis-only and physically cannot place trades.
# It uses only public GET market-data endpoints, which require no authentication.
# BYBIT_API_KEY / BYBIT_API_SECRET are intentionally NOT supported.
# A startup guard fails the boot if either is present.

# ── Persistence (optional; falls back to in-memory store) ────
# Create a project at https://supabase.com then run supabase/migrations/0001_init.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Telegram alerts (optional) ───────────────────────────────
# Create a bot with @BotFather, then get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Cron protection (recommended in production) ──────────────
# Any random string. Vercel Cron sends it automatically once set in Vercel.
CRON_SECRET=

# ── Settings UI write protection (optional) ──────────────────
# If set, the Settings page requires this password to save changes.
ADMIN_PASSWORD=

# ── Optional AI narrative layer (off by default) ─────────────
AI_EXPLANATIONS_ENABLED=false
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
